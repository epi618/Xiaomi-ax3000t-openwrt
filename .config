# ==========================================
# 1. 目标平台与硬件架构 (MT7981 Filogic 820)
# ==========================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-ubootmod=y

CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# 硬件核心驱动
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
CONFIG_PACKAGE_wpad-openssl=y

# ==========================================
# 2. LuCI 基础界面
# ==========================================
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-argon=y

# ==========================================
# 3. Turbo ACC 网络加速
# ==========================================
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y

# ==========================================
# 4. 远程组网 (保留 Tailscale，按需二选一)
# ==========================================
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_tailscale=y
# CONFIG_PACKAGE_luci-app-zerotier is not set

# ==========================================
# 5. 动态域名与管理 (Lucky & DDNS)
# ==========================================
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-ddns=y

# ==========================================
# 6. 多拨、流控与唤醒
# ==========================================
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y

# ==========================================
# 7. PassWall 科学上网 (精简版)
# ==========================================
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# 核心仅保留高效现代的 Sing-Box，剔除体积极大的 Xray
# CONFIG_PACKAGE_passwall_INCLUDE_Xray is not set
CONFIG_PACKAGE_passwall_INCLUDE_SingBox=y

# 核心辅助分流组件
CONFIG_PACKAGE_passwall_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_passwall_INCLUDE_DNS2SOCKS=y

# 剔除冗余的老旧协议编译项 (Sing-Box 原生支持)
# CONFIG_PACKAGE_passwall_INCLUDE_Trojan_Plus is not set
# CONFIG_PACKAGE_passwall_INCLUDE_Shadowsocks_Libev_Full is not set
# CONFIG_PACKAGE_passwall_INCLUDE_ShadowsocksR_Libev_Full is not set

# ==========================================
# 8. 基础依赖与网络工具
# ==========================================
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
