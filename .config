# ==========================================
# 1. 目标平台与硬件架构 (MT7981 Filogic 820)
# ==========================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-ubootmod=y

# 核心系统文件格式
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# 硬件芯片与无线核心
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
CONFIG_PACKAGE_wpad-openssl=y

# ==========================================
# 2. LuCI 基础界面与主题
# ==========================================
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-argon=y

# ==========================================
# 3. Turbo ACC 网络加速 (FLOW 加速 / BBR / DNS)
# ==========================================
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_PDNSD=y

# ==========================================
# 4. 远程组网 (Tailscale & ZeroTier)
# ==========================================
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_zerotier=y

# ==========================================
# 5. 动态域名解析与端口管理 (Lucky & DDNS)
# ==========================================
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-ddns=y

# ==========================================
# 6. 多拨与带宽负载均衡 (MWAN3 & Macvlan)
# ==========================================
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_kmod-macvlan=y

# ==========================================
# 7. 网络唤醒 (WoL)
# ==========================================
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y

# ==========================================
# 8. PassWall 科学上网及运行核心
# ==========================================
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# 代理内核
CONFIG_PACKAGE_passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_passwall_INCLUDE_SingBox=y

# DNS 与调度分流组件
CONFIG_PACKAGE_passwall_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_passwall_INCLUDE_DNS2SOCKS=y
CONFIG_PACKAGE_passwall_INCLUDE_Haproxy=y

# 协议支持
CONFIG_PACKAGE_passwall_INCLUDE_Trojan_Plus=y
CONFIG_PACKAGE_passwall_INCLUDE_Shadowsocks_Libev_Full=y
CONFIG_PACKAGE_passwall_INCLUDE_ShadowsocksR_Libev_Full=y

# ==========================================
# 9. 常用系统管理与底层网络库
# ==========================================
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# ==========================================
# 10. 明确禁用冗余项 (与脚本清理对应)
# ==========================================
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-arpbind is not set# 1. 目标平台与芯片架构 (MT7981 Filogic 820)
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-ubootmod=y

# 2. 核心系统与镜像格式
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# 3. 硬件加速与 Wi-Fi 驱动核心
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
CONFIG_PACKAGE_wpad-openssl=y

# 4. LuCI 基础界面与语言
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-argon=y

# 5. PassWall 核心及组件
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# 5.1 代理内核引擎支持
CONFIG_PACKAGE_passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_passwall_INCLUDE_SingBox=y

# 5.2 DNS 与分流工具组件
CONFIG_PACKAGE_passwall_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_passwall_INCLUDE_DNS2SOCKS=y
CONFIG_PACKAGE_passwall_INCLUDE_Haproxy=y

# 5.3 核心传输与协议依赖
CONFIG_PACKAGE_passwall_INCLUDE_Trojan_Plus=y
CONFIG_PACKAGE_passwall_INCLUDE_Shadowsocks_Libev_Full=y
CONFIG_PACKAGE_passwall_INCLUDE_ShadowsocksR_Libev_Full=y

# 6. 常用系统管理与网络工具
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# 7. 禁用冗余或易冲突项 (与 diy 脚本中的清理对应)
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-arpbind is not set
