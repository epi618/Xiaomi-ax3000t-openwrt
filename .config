# ==========================================
# 1. 目标平台与硬件架构 (MT7981 Filogic 820)
# ==========================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-ubootmod=y

CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# 编译加速缓存支持
CONFIG_CCACHE=y

# 硬件核心与无线驱动
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
CONFIG_PACKAGE_wpad-openssl=y

# ==========================================
# 2. LuCI 基础界面与主题
# ==========================================
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-argon=y

# ==========================================
# 3. Turbo ACC 网络加速
# ==========================================
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y

# ==========================================
# 4. 远程组网 (保留纯 C 编写的轻量 ZeroTier)
# ==========================================
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_zerotier=y
# CONFIG_PACKAGE_luci-app-tailscale is not set
# CONFIG_PACKAGE_tailscale is not set

# ==========================================
# 5. 原生 DDNS (剔除 Lucky)
# ==========================================
CONFIG_PACKAGE_luci-app-ddns=y
# CONFIG_PACKAGE_luci-app-lucky is not set
# CONFIG_PACKAGE_lucky is not set

# ==========================================
# 6. 多拨、流控与局域网唤醒
# ==========================================
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y

# ==========================================
# 7. PassWall 科学上网 (仅保留高效的 Sing-Box)
# ==========================================
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# 核心代理内核
CONFIG_PACKAGE_passwall_INCLUDE_SingBox=y
# CONFIG_PACKAGE_passwall_INCLUDE_Xray is not set

# 分流与辅助解析组件
CONFIG_PACKAGE_passwall_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_passwall_INCLUDE_DNS2SOCKS=y

# ==========================================
# 8. 系统管理与底层网络库
# ==========================================
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
